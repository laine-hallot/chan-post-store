STORAGE_ROOT=/path/to/dataset

# SSH host holding the archives. Any form ssh accepts, e.g. `myhost` or
# `user@myhost`.
NAS_HOST=
NAS_USER=
# Create and install an ssh key with:
#   ssh-keygen -t ed25519 -f ~/.ssh/id_4chan_nas -N ''
#   ssh-copy-id -i ~/.ssh/id_4chan_nas.pub <user>@<host>
NAS_KEY=~/.ssh/id_4chan_nas
# Where the archives live *on that host's own filesystem*
# Used if `config.storage.type` is set to `"remote"`
NAS_ROOT=/path/to/dataset

# Remote DB config
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_DATABASE=
DATABASE_URL="postgres://$DB_USER:$DB_PASSWORD@$DB_HOST:$DB_PORT/$DB_DATABASE"
