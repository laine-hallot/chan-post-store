# Copy to .env (gitignored) to run download/prepare steps on the storage
# host. Without these, everything runs locally.

# SSH host holding the archives. Any form ssh accepts, e.g. `myhost` or
# `user@myhost`.
NAS_HOST=
NAS_USER=laineh
# this one isn't super important sshfs just needs a path to create the
# mount with but once the connection is established you can look at other directories
NAS_MNT_BASE="/target/share/path"

# Remote DB config
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_DATABASE=

# Where the archives live *on that host's own filesystem* — the local path
# behind the network share, not the mount path used from this machine.
# Should be the directory containing the per-source dataset directories.
NAS_ROOT=/path/to/Datasets/4chan

# Dedicated key for this project. Used exclusively (IdentitiesOnly +
# IdentityAgent=none), so any ambient ssh-agent is bypassed — agents that
# serve a varying key set make auth here unreliable.
#
# Create and install with:
#   ssh-keygen -t ed25519 -f ~/.ssh/id_4chan_nas -N ''
#   ssh-copy-id -i ~/.ssh/id_4chan_nas.pub <user>@<host>
NAS_KEY=~/.ssh/id_4chan_nas
